# Server port (default: 3000)
PORT=3000

# Secret used to sign session cookies — replace with a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

# Admin panel seed — creates the tier='admin' user on startup if both are set and the user does not exist yet.
# Leave either one empty to skip admin seeding entirely.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# WhatsApp number (digits only, with country code) shown in the owner dashboard banner as the renew/contact CTA.
# Used to build https://api.whatsapp.com/send?phone={ADMIN_WHATSAPP}
ADMIN_WHATSAPP=5491100000000
